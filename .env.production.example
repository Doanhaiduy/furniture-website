# =============================================================================
# .env.production.example — Template biến môi trường cho PRODUCTION
# Copy sang `.env.production` và điền giá trị THẬT. KHÔNG commit `.env.production`.
# Xem HUONG-DAN-TRIEN-KHAI-VPS.md để biết cách sinh JWT/keys trên VPS.
# =============================================================================

# --- Bắt buộc (app không khởi động nếu thiếu — xem lib/env/schema.ts) ---

# Domain công khai thật (dùng cho sitemap, robots, canonical, email links)
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Supabase — URL công khai trình duyệt gọi tới (self-hosted: domain/kong public)
NEXT_PUBLIC_SUPABASE_URL=https://api.your-domain.com
# Anon key (JWT ký bằng JWT_SECRET của Supabase self-hosted)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — CHỈ server, toàn quyền, tuyệt đối không để lộ ra client
SUPABASE_SERVICE_ROLE_KEY=

# --- Kết nối nội bộ (Docker prod: app -> Supabase qua mạng nội bộ) ---
# Trong docker-compose.production.yml đã set = http://supabase-kong:8000
# SUPABASE_URL_INTERNAL=http://supabase-kong:8000

# Kết nối Postgres trực tiếp (server actions / scripts create-admin, verify-rls)
DATABASE_URL=postgresql://postgres:STRONG_PASSWORD@localhost:5432/postgres

# --- Bảo mật ---
# Khoá mã hoá secret trong Settings (AI keys...). Dùng 32 ký tự (utf-8) HOẶC 64 ký tự hex.
# Gợi ý tạo khoá an toàn: openssl rand -hex 32   (ra 64 ký tự hex)
AI_SECRET_ENCRYPTION_KEY=
# Bí mật cho revalidate on-demand (đặt chuỗi ngẫu nhiên dài)
REVALIDATION_SECRET=
# Tắt mock data ở prod (nếu code có dùng cờ này)
NEXT_PUBLIC_USE_MOCK_DATA=false

# --- Cloudinary (upload ảnh) ---
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=furniture-prod

# --- Email báo giá (Brevo SMTP) ---
# Login SMTP: xem trong Brevo tại SMTP & API -> SMTP (thường là email đăng nhập tài khoản Brevo)
BREVO_SMTP_LOGIN=
# SMTP key: cũng lấy ở trang trên (khác với API key)
BREVO_SMTP_KEY=
# Địa chỉ người gửi — PHẢI được xác minh trong Brevo (Senders -> Add a Sender).
# Chưa có domain thì xác minh 1 địa chỉ email cụ thể (Single Sender); có domain rồi thì
# xác thực domain (SPF/DKIM) và đổi thành no-reply@your-domain.com.
BREVO_SENDER_EMAIL=showroomnoithatphuongdong@gmail.com
# Danh sách email nhận thông báo báo giá, phân tách bằng dấu phẩy
QUOTE_NOTIFICATION_RECIPIENTS=showroomnoithatphuongdong@gmail.com

# --- Google Maps embed (showroom) ---
GOOGLE_MAPS_EMBED_ALLOWED_ORIGIN=https://your-domain.com

# --- AI dịch nội dung (Gemini) — tuỳ chọn ---
GEMINI_API_KEY=
GEMINI_DEFAULT_MODEL=gemini-1.5-pro
